name = "xargcomplete"
home = "https://github.com/bondbox/xargcomplete/"
description = "Tab completion management"
keywords = [
    "argcomplete",
    "argparse",
    "command-line",
    "completion",
    "tab-completion",
]
version = "0.3.1"

[authors.zoumingzhe]
name = "Mingzhe Zou"
email = "zoumingzhe@outlook.com"

[packages.xargcomplete]
requires_python = ">=3.8"
authors = [
    "zoumingzhe",
]
keywords = []
requirements = [
    "xkits-command>=0.7.1",
    "tabulate",
    "pip",
]
build_backend = "hatchling"
max_complexity = 10
max_line_length = 127

[packages.xargcomplete.modules.xargcomplete]
base = "xargcomplete"
exclude = [
    "unittest",
]
omitted = [
    "attribute.py",
    "unittest/*",
]

[packages.xargcomplete.modules.xargcomplete.scripts]
xargcomplete = "command:main"

[packages.xargcomplete.modules.xargcomplete.templates]
"attribute.py" = true
